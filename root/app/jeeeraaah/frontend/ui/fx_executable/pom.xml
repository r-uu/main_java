		<version>0.0.1</version>
	</parent>

	<build>
		<plugins>
			<!-- The javafx-maven-plugin is used here primarily for its jlink capabilities
			     and to ensure JavaFX modules are correctly handled.
			     Its version is managed in the BOM. -->
			<plugin>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-maven-plugin</artifactId>
				<!-- Version is managed in r-uu.bom/pom.xml -->
				<configuration>
					<mainClass>de.ruu.app.jeeeraaah.frontend.ui.fx.task.hierarchy.HierarchiesAppRunner</mainClass>
				</configuration>
				<executions>
					<execution>
						<id>jlink-bundle</id>
						<goals>
							<goal>jlink</goal>
						</goals>
						<configuration>
							<jlinkImageName>jeeeraaah-app</jlinkImageName>
							<compress>2</compress>
							<stripDebug>true</stripDebug>
							<noHeaderFiles>true</noHeaderFiles>
							<noManPages>true</noManPages>
						</configuration>
					</execution>
				</executions>
			</plugin>


	<modelVersion>4.0.0</modelVersion>
	<artifactId>r-uu.app.jeeeraaah.frontend.ui.fx_executable</artifactId>
	<name>${project.artifactId}</name>
	<dependencies>
		<dependency>
			<groupId>r-uu</groupId>
